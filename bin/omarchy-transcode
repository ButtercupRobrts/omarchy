#!/bin/bash

# omarchy:group=transcode
# omarchy:name=
# omarchy:summary=Transcode pictures and videos for sharing
# omarchy:args=[--path path] [--target size] [--codec codec] [--audio codec] [--container fmt] [input] [format] [resolution] [quality]
# omarchy:examples=omarchy transcode|omarchy transcode --path ~/Downloads|omarchy transcode ~/Videos/demo.mov mp4 1080p|omarchy transcode ~/Pictures/background.heic jpg medium|omarchy transcode ~/Videos/demo.mov mp4 1080p low|omarchy transcode ~/Videos/demo.mov mp4 1080p --target 25M|omarchy transcode ~/Videos/demo.mov mp4 1080p --target 10M --codec av1|omarchy transcode ~/Videos/demo.mov mp4 720p --target 10M --audio aac

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  omarchy transcode [--path path] [--target size] [input] [format] [resolution] [quality]

With no input, pick a picture or video from ~/Pictures and ~/Videos,
or only from --path when provided. Then pick the output format, resolution, and for videos the quality.

Options:
  --path path    Limit interactive fuzzy file selection to this path
  --target size  Target output size (e.g. 25M, 1.5G); bare number means MB
  --codec codec  Video codec: h264, hevc, or av1 (default: auto)
  --audio codec  Audio codec: aac, opus, or none (default: auto)
  --container f  Output container: mp4 or mkv (default: auto)

Formats:
  Pictures: jpg, png
  Videos: mp4, gif

Resolutions:
  Pictures: high, medium, low
  Videos: 4k, 1080p, 720p, 540p, 480p

Qualities:
  Videos: high, medium, low (default: medium)
EOF
}

media_type() {
  local mime
  mime=$(file -b --mime-type "$1")

  case "$mime" in
  image/*) echo picture ;;
  video/*) echo video ;;
  *)
    echo "Unsupported file type: $mime" >&2
    return 1
    ;;
  esac
}

output_path() {
  local input="$1"
  local format="$2"
  local resolution="$3"
  local quality="${4:-}"
  local dir base stem name candidate n

  dir=$(dirname -- "$input")
  base=$(basename -- "$input")
  stem="${base%.*}"

  name="$stem-$resolution"
  if [[ -n $quality && $quality != "medium" ]]; then
    name="$name-$quality"
  fi

  candidate="$dir/$name.$format"
  n=2
  while [[ -e $candidate || -L $candidate ]]; do
    candidate="$dir/$name-$n.$format"
    (( n += 1 ))
  done

  printf '%s' "$candidate"
}

transcode_picture() {
  local input="$1" format="$2" resolution="$3" output="$4"
  local resize

  case "$resolution" in
  high) resize='3160x>' ;;
  medium) resize='2160x>' ;;
  low) resize='1080x>' ;;
  *)
    echo "Invalid picture resolution: $resolution" >&2
    return 1
    ;;
  esac

  case "$format" in
  jpg)
    magick "$input" -resize "$resize" -quality 85 -strip "$output"
    ;;
  png)
    magick "$input" -resize "$resize" -strip -define png:compression-filter=5 \
      -define png:compression-level=9 \
      -define png:compression-strategy=1 \
      -define png:exclude-chunk=all \
      "$output"
    ;;
  *)
    echo "Invalid picture format: $format" >&2
    return 1
    ;;
  esac
}

transcode_video() {
  local input="$1" format="$2" resolution="$3" output="$4"
  local quality="${5:-medium}" codec_arg="${6:-}" audio_arg="${7:-}"
  local scale crf_x264 crf_x265 crf_av1 gif_fps codec preset crf
  local audio_args mux_args

  case "$resolution" in
  4k) scale='scale=-2:2160' ;;
  1080p) scale='scale=-2:1080' ;;
  720p) scale='scale=-2:720' ;;
  540p) scale='scale=-2:540' ;;
  480p) scale='scale=-2:480' ;;
  *)
    echo "Invalid video resolution: $resolution" >&2
    return 1
    ;;
  esac

  # crf_av1 runs ~+10 vs x264 for equivalent quality at roughly 40% less
  # size -- calibrated on motion-heavy 720p content, not a lookup table.
  case "$quality" in
  high) crf_x264=18; crf_x265=20; crf_av1=28; gif_fps=15 ;;
  medium) crf_x264=23; crf_x265=24; crf_av1=33; gif_fps=10 ;;
  low) crf_x264=28; crf_x265=28; crf_av1=38; gif_fps=5 ;;
  *)
    echo "Invalid video quality: $quality (expected high, medium, or low)" >&2
    return 1
    ;;
  esac

  case "$format" in
  mp4 | mkv)
    # Codec: an explicit --codec wins; otherwise the locked 4k-keyed split.
    case "$codec_arg" in
    h264) codec=libx264; preset=fast; crf=$crf_x264 ;;
    hevc) codec=libx265; preset=slow; crf=$crf_x265 ;;
    av1) codec=libsvtav1; preset=6; crf=$crf_av1 ;;
    *)
      if [[ $resolution == "4k" ]]; then
        codec=libx265; preset=slow; crf=$crf_x265
      else
        codec=libx264; preset=fast; crf=$crf_x264
      fi
      ;;
    esac

    case "${audio_arg:-aac}" in
    aac) audio_args=(-c:a aac -b:a 192k) ;;
    opus) audio_args=(-c:a libopus -b:a 56k) ;;
    none) audio_args=(-an) ;;
    esac
    mux_args=()
    [[ $format == "mp4" ]] && mux_args=(-movflags +faststart)

    ffmpeg -i "$input" -vf "$scale" -c:v "$codec" -preset "$preset" -crf "$crf" \
      "${audio_args[@]}" "${mux_args[@]}" "$output"
    ;;
  gif)
    ffmpeg -i "$input" -vf "fps=$gif_fps,$scale:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" "$output"
    ;;
  *)
    echo "Invalid video format: $format" >&2
    return 1
    ;;
  esac
}

copy_to_clipboard() {
  local output="$1"
  local uri

  uri="file://$(realpath -- "$output")"
  printf '%s\n' "$uri" | wl-copy --type text/uri-list
}

# Prints the input's duration in seconds, or fails when ffprobe cannot produce
# a numeric value (N/A, an unreadable stream, a probe error) -- callers then
# degrade to qualitative rows. No -- terminator: matches the repo's existing
# ffprobe call sites.
video_duration() {
  local duration
  duration=$(ffprobe -v error -show_entries format=duration \
    -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null || true)
  [[ $duration =~ ^[0-9.]+$ ]] || return 1
  printf '%s' "$duration"
}

# 192 when the input has an audio stream, 0 when it provably has none; a failed
# probe keeps 192 -- conservative over-estimate, never under.
video_audio_kbps() {
  local streams
  if streams=$(ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$1" 2>/dev/null); then
    [[ $streams == *audio* ]] || { echo 0; return; }
  fi
  echo 192
}

# Display token for a tier: "CRF N" for mp4 (an explicit --codec picks its
# own column; otherwise keyed on resolution, mirroring transcode_video's
# x264/x265 split), "N fps" for gif. The CRF/fps constants deliberately
# duplicate transcode_video's quality case -- the subtext must name the
# effective codec's CRF, and a shared table would refactor that code inside
# the PR #6698 conflict window.
quality_token() {
  local format="$1" resolution="$2" quality="$3" codec="${4:-}"

  case "$format" in
  mp4)
    case "$codec" in
    h264)
      case "$quality" in
      high) printf 'CRF 18' ;;
      medium) printf 'CRF 23' ;;
      low) printf 'CRF 28' ;;
      esac
      ;;
    hevc)
      case "$quality" in
      high) printf 'CRF 20' ;;
      medium) printf 'CRF 24' ;;
      low) printf 'CRF 28' ;;
      esac
      ;;
    av1)
      case "$quality" in
      high) printf 'CRF 28' ;;
      medium) printf 'CRF 33' ;;
      low) printf 'CRF 38' ;;
      esac
      ;;
    *)
      if [[ $resolution == "4k" ]]; then
        case "$quality" in
        high) printf 'CRF 20' ;;
        medium) printf 'CRF 24' ;;
        low) printf 'CRF 28' ;;
        esac
      else
        case "$quality" in
        high) printf 'CRF 18' ;;
        medium) printf 'CRF 23' ;;
        low) printf 'CRF 28' ;;
        esac
      fi
      ;;
    esac
    ;;
  gif)
    case "$quality" in
    high) printf '15 fps' ;;
    medium) printf '10 fps' ;;
    low) printf '5 fps' ;;
    esac
    ;;
  esac
  # Unknown format prints nothing; callers use the qualitative fallback.
}

# Video bitrate midpoint in kbps for the mp4 estimate (locked Mbps table).
# Unknown resolution prints nothing, which drives the qualitative fallback.
quality_kbps() {
  case "$1" in
  480p)  case "$2" in high) echo 1200  ;; medium) echo 700 ;; low) echo 350  ;; esac ;;
  540p)  case "$2" in high) echo 1800  ;; medium) echo 1000 ;; low) echo 500  ;; esac ;;
  720p)  case "$2" in high) echo 2500  ;; medium) echo 1500 ;; low) echo 700  ;; esac ;;
  1080p) case "$2" in high) echo 5500  ;; medium) echo 3000 ;; low) echo 1400 ;; esac ;;
  4k)    case "$2" in high) echo 16000 ;; medium) echo 9000 ;; low) echo 4500 ;; esac ;;
  esac
}

# "~N MB" at 1-2 sig figs, or "larger than source" when the estimate would
# exceed the input's byte size. An empty $4 (stat failed) disables the
# comparison. The -v values are regex-gated to digits upstream, which is what
# makes the awk assignments safe.
estimate_label() {
  awk -v dur="$1" -v kbps="$2" -v audio="$3" -v src="$4" 'BEGIN {
    bytes = dur * (kbps + audio) * 125          # kbps * 1000 / 8 bytes per second
    if (src != "" && bytes > src) { print "larger than source"; exit }
    mb = bytes / 1000000                      # decimal MB -- matches file managers and upload limits
    if (mb < 1) { print "~1 MB"; exit }
    d = int(log(mb) / log(10)) - 1            # round to 2 significant figures
    if (d < -1) d = -1
    r = int(mb / (10 ^ d) + 0.5) * (10 ^ d)
    printf "~%.0f MB", r
  }'
}

# Builds the quality rows as "\t<tier>\t<subtext>" argv (the leading tab is the
# empty glyph field), pre-highlights medium, and prints the picked tier -- or
# "target:<bytes>" when the mp4-only Custom size… row is picked, which main()
# unwraps into the --target path. The "label\tsubtext" return is stripped at the
# first tab and re-validated here so a foreign label dies inside the helper,
# before the notification boundary -- never reaching output_path or ffmpeg.
select_quality() {
  local input="$1" format="$2" resolution="$3" codec="${4:-}"
  local duration="" src_bytes="" audio_kbps=192 tier subtext selection custom_label="Custom size…" custom_subtext="Enter a size like 25M" bytes
  local rows=()

  if [[ $format == "mp4" ]]; then
    duration=$(video_duration "$input") || duration=""
    src_bytes=$(stat -c %s "$input" 2>/dev/null || true)
    [[ $src_bytes =~ ^[0-9]+$ ]] || src_bytes=""
    audio_kbps=$(video_audio_kbps "$input")
  fi

  local kbps
  for tier in high medium low; do
    kbps=$(quality_kbps "$resolution" "$tier")
    if [[ $format == "gif" ]]; then
      subtext=$(quality_token gif "$resolution" "$tier")
    elif [[ -n $duration && -n $kbps ]]; then
      subtext="$(quality_token mp4 "$resolution" "$tier" "$codec") · $(estimate_label "$duration" "$kbps" "$audio_kbps" "$src_bytes")"
    else
      case "$tier" in
      high) subtext="Best quality" ;;
      medium) subtext="Balanced" ;;
      low) subtext="Smallest file" ;;
      esac
    fi
    rows+=($'\t'"$tier"$'\t'"$subtext")
  done

  # mp4 only: the sentinel row's label doubles as its key -- the menu returns
  # "label\tsubtext", and the strip below hands the label back verbatim.
  [[ $format == "mp4" ]] && rows+=($'\t'"$custom_label"$'\t'"$custom_subtext")

  selection=$(omarchy-menu-select "Select quality" "${rows[@]}" -- --default-index 1) || return

  selection="${selection%%$'\t'*}"

  if [[ $format == "mp4" && $selection == "$custom_label" ]]; then
    bytes=$(prompt_target_size) || return
    printf 'target:%s' "$bytes"
    return
  fi

  case "$selection" in
  high | medium | low) ;;
  *)
    echo "Invalid video quality: $selection (expected high, medium, or low)" >&2
    return 1
    ;;
  esac

  printf '%s' "$selection"
}

# The interactive container pick, shown only inside the Custom-size flow:
# "auto" lets the planner pair audio and container by budget (aac -> mp4,
# opus -> mkv), mp4 constrains the ladder to aac for players that reject
# the exotic pairings. mkv earns no row -- auto already emits it when the
# budget starves, and forcing it past that is niche enough to stay flag-
# only (--container mkv). auto is pre-highlighted so Enter keeps the
# default; Esc cancels like every other prompt; the label is stripped and
# re-validated like select_quality's.
select_container() {
  local selection
  selection=$(omarchy-menu-select "Select container" \
    auto "Smallest result (may be .mkv)" \
    mp4 "Plays everywhere (slightly bigger)" -- --width 560 --default-index 0) || return
  selection="${selection%%$'\t'*}"
  case "$selection" in
  auto | mp4) printf '%s' "$selection" ;;
  *)
    echo "Invalid container choice: $selection (expected auto or mp4)" >&2
    return 1
    ;;
  esac
}

# Human-readable size of a finished output ("38 MB"), or fails when stat
# cannot read it -- callers degrade the notification body rather than lie.
output_size_label() {
  local bytes
  bytes=$(stat -c %s "$1" 2>/dev/null || true)
  [[ $bytes =~ ^[0-9]+$ ]] || return 1
  awk -v b="$bytes" 'BEGIN {
    if (b > 0 && b < 1000000) { printf "<1 MB"; exit }
    printf "%.0f MB", b / 1000000
  }'
}

# Parses a free-text --target size ("25M", "1.5G", "500K", "25MB", bare "25"
# meaning MB) into integer bytes on stdout, or prints an error on stderr and
# returns 1. A pure validator -- callers own the exit code (the flag arm
# propagates 2) and Phase 9's Custom size row re-prompts on failure. The raw
# string is discarded here: only the integer bytes and the numfmt --to=si
# token derived from them ever reach a filename or ffmpeg argv. Units are
# decimal (SI): 25M means 25,000,000 bytes, matching file managers and
# upload limits like Discord's.
parse_target_size() {
  local raw="$1" normalized bytes

  [[ $raw =~ ^[0-9]+(\.[0-9]+)?([kKmMgG][bB]?)?$ ]] ||
    { echo "Invalid target size: $raw" >&2; return 1; }

  normalized="${raw%[bB]}"      # drop an optional trailing B: 25MB -> 25M
  normalized="${normalized^^}"  # uppercase the unit letter: 25m -> 25M
  [[ $normalized =~ [KMG]$ ]] || normalized+="M" # a bare number means MB

  bytes=$(numfmt --from=si "$normalized") ||
    { echo "Invalid target size: $raw" >&2; return 1; }
  (( bytes > 0 )) ||
    { echo "Invalid target size: $raw" >&2; return 1; }

  printf '%s' "$bytes"
}

# Prompts for a free-text target size behind the Custom size… row. Re-prompts
# exactly once -- the second prompt carries an error hint so it reads as
# "invalid", not "didn't take" (D-02) -- then cancels. Esc cancels at either
# prompt like every sibling. Empty submits ride through parse_target_size with
# everything else: one validator for both entry points. Planner refusals are
# NOT this loop's business (D-01).
prompt_target_size() {
  local prompt="Target size (e.g. 25M)" answer bytes attempt
  for attempt in 1 2; do
    answer=$(omarchy-menu-input "$prompt") || return 1
    if bytes=$(parse_target_size "$answer"); then
      printf '%s' "$bytes"
      return 0
    fi
    prompt="Invalid size — e.g. 25M"
  done
  return 1
}

# Prints the input's average frame rate as an integer, or fails when the
# probe cannot produce one (ffprobe reports a rational like "25/1" or
# "30000/1001"; N/A or a dead probe both fail). Callers fall back to 25 --
# only used for the codec bpp heuristic, so a wrong-but-close fps is never
# fatal.
video_fps() {
  local fps
  fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=avg_frame_rate \
    -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null || true)
  awk -v f="$fps" 'BEGIN {
    if (f ~ /^[0-9]+\/[0-9]+$/) {
      split(f, a, "/")
      if (a[2] > 0) { printf "%d", a[1] / a[2] + 0.5; exit 0 }
    }
    exit 1
  }'
}

# Prints the input's video height in pixels, or fails when ffprobe cannot
# produce a numeric value -- callers then skip the no-upscale clamp rather
# than refuse. Same probe contract as video_duration.
video_height() {
  local height
  height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height \
    -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null || true)
  [[ $height =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$height"
}

# The audio ladder for --target: the probed stream gets aac at the locked
# 192k while the net budget holds that under ~25% share (net >= 768k), aac
# 128k down to its own 25% share (net >= 512k), and libopus 56k below --
# where a fixed 192k would claim most of the budget and leave the video
# nothing. A source with no audio stream returns none/0 and frees the whole
# budget for the video. An explicit --audio override pins the codec -- aac
# still tiers inside itself (192 only while affordable, else 128), opus is
# the single 56k rung, none drops audio even when a stream exists -- but a
# forced codec still cannot encode a stream the source does not have.
# Prints "<codec> <kbps>" for the plan vector; "none" is a codec the encode
# arm maps to no audio args.
choose_audio() {
  local budget="$1" has_audio="${2:-1}" prefer="${3:-}" container="${4:-}"
  if (( has_audio == 0 )) || [[ $prefer == "none" ]]; then
    printf 'none 0\n'
  elif [[ $prefer == "opus" ]]; then
    printf 'libopus 56\n'
  elif [[ $prefer == "aac" || $container == "mp4" ]]; then
    # Forced aac, or a forced mp4 container -- which cannot take opus --
    # both land on the aac ladder.
    if (( budget >= 768 )); then
      printf 'aac 192\n'
    else
      printf 'aac 128\n'
    fi
  elif (( budget >= 768 )); then
    printf 'aac 192\n'
  elif (( budget >= 512 )); then
    printf 'aac 128\n'
  else
    printf 'libopus 56\n'
  fi
}

# Plans a --target run: refuses a target at or above the source size (a
# re-encode can only degrade it -- drop --target and pick a quality for format
# conversion), probes duration and audio, derives the video bitrate
# (target*8/duration/1000 with a ~2% container reserve, minus the chosen
# audio tier), clamps the requested rung to at most the source height (a
# --target run never upscales), then walks the locked 2000/800/400/250/180
# kbps floors stepping 4k -> 1080p -> 720p -> 540p -> 480p until the budget
# fits. An optional 4th argument pins the codec (h264|hevc|av1) and skips
# both the bpp heuristic and its frame-rate probe; an optional 5th pins the
# audio codec (aac|opus|none). Prints the plan vector
# "<res> <v_kbps> <a_codec> <a_kbps> <v_codec> <preset> <container>" on
# stdout; every refusal prints to stderr and returns nonzero, and cheap
# refusals precede the probes. A negative or zero derived bitrate is not
# special-cased -- it rides the floor loop to the 480p refusal, which IS the
# audio-alone-exceeds-budget refusal, so no negative, zero, or -nan -b:v ever
# reaches ffmpeg argv.
plan_target() {
  local input="$1" target_bytes="$2" res="$3" codec_arg="${4:-}" audio_arg="${5:-}" container_arg="${6:-}"
  local src_bytes duration audio_kbps video_kbps floor min_label
  local net_kbps a_codec a_kbps v_codec preset container
  local src_height rung rw rh fps

  src_bytes=$(stat -c %s "$input" 2>/dev/null || true)
  if [[ $src_bytes =~ ^[0-9]+$ ]] && (( target_bytes >= src_bytes )); then
    echo "Invalid --target: $(numfmt --to=si "$target_bytes") meets or exceeds the source size ($(numfmt --to=si "$src_bytes")); drop --target and pick a quality for format conversion" >&2
    return 1
  fi

  # The probed duration is mandatory -- there is no qualitative fallback under
  # --target. Captures stay on their own lines so a nonzero status is never
  # masked by local.
  duration=$(video_duration "$input") ||
    { echo "Cannot determine duration for $input; cannot size to a target" >&2; return 1; }
  audio_kbps=$(video_audio_kbps "$input")

  # Duration is gated inside awk because (( )) cannot compare floats ("60.033"
  # is a syntax error there). %d truncates toward zero and may go negative;
  # the floor loop converts that into the lowest-rung refusal.
  net_kbps=$(awk -v b="$target_bytes" -v d="$duration" 'BEGIN {
    if (d <= 0) exit 1
    printf "%d", b * 8 / d / 1000 * 0.98
  }') ||
    { echo "Cannot determine duration for $input; cannot size to a target" >&2; return 1; }

  read -r a_codec a_kbps <<<"$(choose_audio "$net_kbps" "$audio_kbps" "$audio_arg" "$container_arg")"
  video_kbps=$(( net_kbps - a_kbps ))

  # Container: an explicit pick wins; otherwise opus forces mkv (mp4+opus
  # muxes but enough players choke on the audio track that it is not worth
  # the toast explaining a silent file) and everything else is mp4.
  container=${container_arg:-mp4}
  if [[ -z $container_arg && $a_codec == "libopus" ]]; then
    container=mkv
  fi

  # No-upscale clamp: size-targeted output never exceeds the source height,
  # so the requested rung steps down the same ladder to fit the source before
  # the budget floors apply. A failed height probe skips the clamp; a source
  # below 480p lands on 480p -- the lowest rung we ship.
  src_height=$(video_height "$input" || true)
  if [[ $src_height =~ ^[0-9]+$ ]]; then
    while :; do
      case "$res" in
      4k) rung=2160 ;;
      1080p) rung=1080 ;;
      720p) rung=720 ;;
      540p) rung=540 ;;
      480p) rung=480 ;;
      *) break ;;
      esac
      (( rung <= src_height )) && break
      case "$res" in
      4k) res=1080p ;;
      1080p) res=720p ;;
      720p) res=540p ;;
      540p) res=480p ;;
      *) break ;;
      esac
    done
  fi

  while :; do
    case "$res" in
    4k) floor=2000 ;;
    1080p) floor=800 ;;
    720p) floor=400 ;;
    540p) floor=250 ;;
    480p) floor=180 ;;
    *) echo "Invalid video resolution: $res" >&2; return 1 ;;
    esac
    (( video_kbps >= floor )) && break
    case "$res" in
    4k) res=1080p ;;
    1080p) res=720p ;;
    720p) res=540p ;;
    540p) res=480p ;;
    *)
      # Below the 480p floor: refuse naming the achievable minimum at that
      # floor -- (floor + chosen audio) * duration * 125 bytes, in decimal MB.
      min_label=$(awk -v a="$a_kbps" -v d="$duration" \
        'BEGIN { printf "%.0f MB", (180 + a) * d * 125 / 1000000 }')
      echo "Cannot fit under $(numfmt --to=si "$target_bytes") -- smallest achievable is ~$min_label for this duration" >&2
      return 1
      ;;
    esac
  done

  # Codec decision: an explicit --codec overrides everything; otherwise
  # bits-per-pixel at the rung's nominal 16:9 geometry and the probed frame
  # rate decides -- under ~0.035 bpp the bitrate is starvation territory
  # where AV1's efficiency beats h264 compatibility; above it the locked
  # x264/x265 4k-split stands. Widths are nominal (scale=-2:H keeps source
  # aspect), so wide sources read slightly low -- the conservative direction.
  if [[ -n $codec_arg ]]; then
    case "$codec_arg" in
    h264) v_codec=libx264; preset=fast ;;
    hevc) v_codec=libx265; preset=slow ;;
    av1) v_codec=libsvtav1; preset=6 ;;
    esac
  else
    case "$res" in
    4k) rw=3840; rh=2160 ;;
    1080p) rw=1920; rh=1080 ;;
    720p) rw=1280; rh=720 ;;
    540p) rw=960; rh=540 ;;
    480p) rw=854; rh=480 ;;
    esac
    fps=$(video_fps "$input" || true)
    [[ $fps =~ ^[0-9]+$ ]] || fps=25

    if awk -v k="$video_kbps" -v w="$rw" -v h="$rh" -v f="$fps" \
         'BEGIN { exit !(k * 1000 / (w * h * f) < 0.035) }'; then
      v_codec=libsvtav1
      preset=6
    elif [[ $res == "4k" ]]; then
      v_codec=libx265
      preset=slow
    else
      v_codec=libx264
      preset=fast
    fi
  fi

  printf '%s %s %s %s %s %s %s\n' "$res" "$video_kbps" "$a_codec" "$a_kbps" "$v_codec" "$preset" "$container"
}

# Encodes a --target run from the plan vector: two-pass codecs write pass-1
# stats into a per-run mktemp passdir under TMPDIR (never the output dir -- a
# stale passlog would silently corrupt the next run) and pass 2 encodes at
# the derived -b:v. The passdir is removed whole by an EXIT trap plus an
# explicit rm at the end -- EXIT, not RETURN, because a failed pass aborts
# under set -e without firing function-return traps, and the -d guard keeps
# the persisted trap inert after return (this script has no other EXIT trap).
# -vf/-c:v/-preset/-b:v are identical across passes; -an only on pass 1,
# audio/muxer args only on the producing passes, and no -crf anywhere (the
# tier arms own that flag). The scale table deliberately duplicates
# transcode_video's per the quality_token convention -- a shared table would
# refactor that code inside the PR conflict window.
transcode_video_target() {
  local input="$1" resolution="$2" output="$3" video_kbps="$4"
  local a_codec="$5" a_kbps="$6" v_codec="$7" preset="$8" container="$9"
  local target_bytes="${10}" notify_id="${11:-}" desc="${12:-}"
  local scale passdir actual retry_kbps
  local vargs margs rargs

  case "$resolution" in
  4k) scale='scale=-2:2160' ;;
  1080p) scale='scale=-2:1080' ;;
  720p) scale='scale=-2:720' ;;
  540p) scale='scale=-2:540' ;;
  480p) scale='scale=-2:480' ;;
  *)
    echo "Invalid video resolution: $resolution" >&2
    return 1
    ;;
  esac

  vargs=(-vf "$scale" -c:v "$v_codec" -preset "$preset" -b:v "${video_kbps}k")
  margs=()
  if (( a_kbps > 0 )); then
    margs+=(-c:a "$a_codec" -b:a "${a_kbps}k")
  else
    # No audio args is not "no audio": ffmpeg's default stream selection
    # would mux the source audio anyway. -an makes none explicit.
    margs+=(-an)
  fi
  if [[ $container == "mp4" ]]; then
    margs+=(-movflags +faststart)
  fi

  # The trap bakes the resolved path in -- locals die with the function under
  # errexit, so a '$passdir' trap would see the variable already unset.
  passdir=$(mktemp -d "${TMPDIR:-/tmp}/transcode-2pass.XXXXXX")
  trap "rm -rf -- $(printf '%q' "$passdir")" EXIT

  if [[ $v_codec == "libsvtav1" ]]; then
    # Single-pass VBR: this ffmpeg's libsvtav1 wrapper has no two-pass
    # wiring, and the encode is fast enough that a second pass buys nothing
    # the overshoot retry cannot recover.
    ffmpeg -i "$input" "${vargs[@]}" "${margs[@]}" "$output"
  else
    ffmpeg -i "$input" "${vargs[@]}" -pass 1 -passlogfile "$passdir/2pass" \
      -an -f null /dev/null

    # One toast, replaced in place: pass 1/2 -> pass 2/2. A real if keeps the
    # skip deliberate -- a failing [[ ]] && cmd statement would be silently
    # inert too, but if names the intent.
    if [[ $notify_id =~ ^[0-9]+$ ]]; then
      omarchy-notification-send -r "$notify_id" -g  "Transcoding video…" \
        "${desc:-$(basename -- "$input") to $container ($resolution}, pass 2/2)" || true
    fi

    ffmpeg -i "$input" "${vargs[@]}" -pass 2 -passlogfile "$passdir/2pass" \
      "${margs[@]}" "$output"
  fi

  # Any byte-over target triggers exactly one retry at a tightened bitrate
  # -- video_kbps scaled by target/actual, resolution and audio fixed
  # (re-planning could silently move resolution after the filename and
  # toasts committed to it). Two-pass codecs reuse the pass-1 log for the
  # retry; single-pass codecs just re-encode fresh. The retry encodes to a
  # passdir sibling -- unique, so no -y is ever needed -- and mv's onto
  # $output only on success, so a failed retry preserves the
  # overshot-but-playable first output. The done toast reports the
  # stat-measured actual size either way; that honest hit/miss report is
  # the point of the feature.
  actual=$(stat -c %s "$output" 2>/dev/null || true)
  if [[ $actual =~ ^[0-9]+$ ]] && (( actual > target_bytes )); then
    retry_kbps=$(awk -v k="$video_kbps" -v t="$target_bytes" -v a="$actual" \
      'BEGIN { printf "%d", k * t / a }')
    if [[ $retry_kbps =~ ^[0-9]+$ ]] && (( retry_kbps > 0 )); then
      rargs=(-vf "$scale" -c:v "$v_codec" -preset "$preset" -b:v "${retry_kbps}k")
      if [[ $v_codec != "libsvtav1" ]]; then
        rargs+=(-pass 2 -passlogfile "$passdir/2pass")
      fi
      if ffmpeg -i "$input" "${rargs[@]}" "${margs[@]}" "$passdir/retry.$container"; then
        mv -f -- "$passdir/retry.$container" "$output"
      fi
    fi
  fi

  # The two-pass retry reuses the passlog, so the explicit cleanup waits
  # until here; the EXIT trap stays armed as the failure-path backstop.
  rm -rf "$passdir"
}

main() {
  local input="" format="" resolution="" search_path=""
  local type output quality size positional=()
  local target_bytes="" target_token="" video_kbps="" requested_resolution=""
  local notify_id="" plan="" target_desc=""
  local a_codec="" a_kbps="" v_codec="" preset="" container="" codec_arg=""
  local audio_arg="" container_arg=""

  while (( $# > 0 )); do
    case "$1" in
    --path)
      shift
      (( $# > 0 )) || { echo "Missing value for --path" >&2; return 2; }
      search_path="$1"
      ;;
    --target)
      shift
      (( $# > 0 )) || { echo "Missing value for --target" >&2; return 2; }
      target_bytes=$(parse_target_size "$1") || return 2
      target_token=$(numfmt --to=si "$target_bytes")
      ;;
    --codec)
      shift
      (( $# > 0 )) || { echo "Missing value for --codec" >&2; return 2; }
      case "$1" in
      h264 | hevc | av1) codec_arg="$1" ;;
      *)
        echo "Invalid --codec: $1 (expected h264, hevc, or av1)" >&2
        return 2
        ;;
      esac
      ;;
    --audio)
      shift
      (( $# > 0 )) || { echo "Missing value for --audio" >&2; return 2; }
      case "$1" in
      aac | opus | none) audio_arg="$1" ;;
      *)
        echo "Invalid --audio: $1 (expected aac, opus, or none)" >&2
        return 2
        ;;
      esac
      ;;
    --container)
      shift
      (( $# > 0 )) || { echo "Missing value for --container" >&2; return 2; }
      case "$1" in
      mp4 | mkv) container_arg="$1" ;;
      *)
        echo "Invalid --container: $1 (expected mp4 or mkv)" >&2
        return 2
        ;;
      esac
      ;;
    --help | -h)
      usage
      return 0
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      return 2
      ;;
    *)
      positional+=("$1")
      ;;
    esac
    shift
  done

  input="${positional[0]:-}"
  format="${positional[1]:-}"
  resolution="${positional[2]:-}"
  quality="${positional[3]:-}"
  search_path="${search_path:-$HOME/Pictures:$HOME/Videos}"

  if [[ -z $input ]]; then
    input=$(omarchy-menu-file "Transcode picture or video" "$search_path" "jpg jpeg png webp gif heic avif mp4 mov m4v mkv webm avi")
  fi

  [[ -n $input ]] || return 1
  [[ -f $input ]] || { echo "File not found: $input" >&2; return 1; }

  type=$(media_type "$input")

  if [[ -n $quality ]]; then
    if [[ -n $target_bytes ]]; then
      echo "Invalid argument: --target cannot be combined with a quality tier ($quality)" >&2
      return 1
    fi
    if [[ $type == "picture" ]]; then
      echo "Invalid argument: quality applies to videos only" >&2
      return 1
    fi

    case "$quality" in
    high | medium | low) ;;
    *)
      echo "Invalid video quality: $quality (expected high, medium, or low)" >&2
      return 1
      ;;
    esac
  fi

  if [[ -n $target_bytes && $type == "picture" ]]; then
    echo "Invalid argument: --target applies to videos only" >&2
    return 1
  fi

  # --codec/--audio have no meaning on pictures -- refuse early, before the
  # menus. The gif counterpart lives in the video validation block below,
  # after the format menu has resolved.
  if [[ $type == "picture" && ( -n $codec_arg || -n $audio_arg || -n $container_arg ) ]]; then
    echo "Invalid argument: --codec, --audio, and --container apply to videos only" >&2
    return 1
  fi

  # mp4+opus is the one pairing we refuse to ship -- too many players accept
  # the container and then silence the audio track.
  if [[ $audio_arg == "opus" && $container_arg == "mp4" ]]; then
    echo "Invalid argument: --container mp4 cannot be combined with --audio opus" >&2
    return 1
  fi

  if [[ -z $format ]]; then
    if [[ $type == "picture" ]]; then
      format=$(omarchy-menu-select "Select format" jpg png)
    else
      format=$(omarchy-menu-select "Select format" mp4 gif)
    fi
  fi

  if [[ -z $resolution ]]; then
    if [[ $type == "picture" ]]; then
      resolution=$(omarchy-menu-select "Select resolution" high medium low)
    else
      resolution=$(omarchy-menu-select "Select resolution" 4k 1080p 720p 540p 480p)
    fi
  fi

  if [[ $type == "video" ]]; then
    case "$format" in
    mp4 | gif) ;;
    *)
      echo "Invalid video format: $format" >&2
      return 1
      ;;
    esac
    # Format may have come from the interactive menu, so the gif refusal
    # lives here -- a menu-picked gif under --target dies on this check, not
    # on the resolution case below.
    if [[ -n $target_bytes && $format == "gif" ]]; then
      echo "Invalid argument: --target is not supported for gif output" >&2
      return 1
    fi
    # Same gif rule for the override flags -- a gif encode has no video codec
    # or audio stream for them to steer.
    if [[ $format == "gif" && -n $codec_arg ]]; then
      echo "Invalid argument: --codec is not supported for gif output" >&2
      return 1
    fi
    if [[ $format == "gif" && -n $audio_arg ]]; then
      echo "Invalid argument: --audio is not supported for gif output" >&2
      return 1
    fi
    if [[ $format == "gif" && -n $container_arg ]]; then
      echo "Invalid argument: --container is not supported for gif output" >&2
      return 1
    fi
    case "$resolution" in
    4k | 1080p | 720p | 540p | 480p) ;;
    *)
      echo "Invalid video resolution: $resolution" >&2
      return 1
      ;;
    esac
  else
    case "$format" in
    jpg | png) ;;
    *)
      echo "Invalid picture format: $format" >&2
      return 1
      ;;
    esac
    case "$resolution" in
    high | medium | low) ;;
    *)
      echo "Invalid picture resolution: $resolution" >&2
      return 1
      ;;
    esac
  fi

  if [[ $type == "video" && -z $quality && -z $target_bytes ]]; then
    quality=$(select_quality "$input" "$format" "$resolution" "$codec_arg")
    # A Custom size… pick returns target:<bytes> -- unwrap into the same two
    # variables --target sets, so the planner block, output_path, and the
    # dispatch below are byte-identical to a CLI run (D-00f).
    if [[ $quality == target:* ]]; then
      target_bytes="${quality#target:}"
      [[ $target_bytes =~ ^[0-9]+$ ]] ||
        { echo "Invalid target size: $target_bytes" >&2; return 1; }
      target_token=$(numfmt --to=si "$target_bytes")
      quality=""
      # The Custom-size pick is the one interactive moment a container
      # choice changes the plan: offer it there and nowhere else -- the
      # audio ladder itself stays automatic. --container and --audio opus
      # both make the pick redundant (opus already implies mkv).
      if [[ -z $container_arg && $audio_arg != "opus" ]]; then
        container_arg=$(select_container) || return
        if [[ $container_arg == "auto" ]]; then
          container_arg=""
        fi
      fi
    fi
  fi

  # Under --target the planner runs after every menu and before the output
  # name: it may step the requested resolution down to the highest rung whose
  # bitrate floor fits, and writing the effective rung back into $resolution
  # makes the filename and both toasts name it for free.
  if [[ -n $target_bytes ]]; then
    requested_resolution="$resolution"
    plan=$(plan_target "$input" "$target_bytes" "$requested_resolution" "$codec_arg" "$audio_arg" "$container_arg")
    read -r resolution video_kbps a_codec a_kbps v_codec preset container <<<"$plan"
    # The container becomes the effective format: extension, toasts, and the
    # done label all name it for free.
    format="$container"
  else
    # The tier path applies the same container rule the planner enforces:
    # an explicit pick wins, opus otherwise ships mkv.
    if [[ -n $container_arg ]]; then
      format="$container_arg"
    elif [[ $audio_arg == "opus" ]]; then
      format=mkv
    fi
  fi

  output=$(output_path "$input" "$format" "$resolution" "${target_token:-$quality}")

  if [[ $type == "video" ]]; then
    if [[ -n $target_bytes ]]; then
      # The start toast carries the effective resolution, the step-down
      # disclosure, and the target; -p captures the daemon id so the pass-2
      # update inside transcode_video_target can replace it in place.
      target_desc="$(basename -- "$input") to $format ($resolution"
      if [[ $requested_resolution != "$resolution" ]]; then
        target_desc+=" — stepped down from $requested_resolution"
      fi
      target_desc+=", target ≤$target_token"
      # Two-pass codecs get a pass counter on the start toast (replaced in
      # place by pass 2/2); single-pass codecs encode once, so there is no
      # counter to update.
      if [[ $v_codec == "libsvtav1" ]]; then
        pass_label=""
      else
        pass_label=", pass 1/2"
      fi
      notify_id=$(omarchy-notification-send -p -g  "Transcoding video…" "$target_desc$pass_label)")
      transcode_video_target "$input" "$resolution" "$output" "$video_kbps" \
        "$a_codec" "$a_kbps" "$v_codec" "$preset" "$container" \
        "$target_bytes" "$notify_id" "$target_desc"
    else
      omarchy-notification-send -g  "Transcoding video…" "$(basename -- "$input") to $format ($resolution)"
      transcode_video "$input" "$format" "$resolution" "$output" "$quality" "$codec_arg" "$audio_arg"
    fi
    copy_to_clipboard "$output"
    size=$(output_size_label "$output" || true)
    omarchy-notification-send -g  "Transcoded to $resolution $format" "Saved and copied to clipboard${size:+ ($size)}."
  else
    transcode_picture "$input" "$format" "$resolution" "$output"
    copy_to_clipboard "$output"
    size=$(output_size_label "$output" || true)
    omarchy-notification-send -g  "Transcoded to $resolution $format" "Saved and copied to clipboard${size:+ ($size)}."
  fi
}

main "$@"
